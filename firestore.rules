rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clients never write directly. The server derives uid from a verified Firebase ID token.
    // Admin SDK bypasses these rules, so server isolation tests are mandatory too.
    match /users/{uid}/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
